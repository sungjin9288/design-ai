# Server-only Image Console configuration. Do not expose these values to browser files.
# PROMPT_GUIDE_MODE=mock is deterministic development/test mode and is rejected in production.
PROMPT_GUIDE_MODE=mock
PROMPT_GUIDE_BASE_URL=http://127.0.0.1:8000
PROMPT_GUIDE_API_KEY=
PROMPT_GUIDE_TIMEOUT_MS=15000
PROMPT_GUIDE_EXPECTED_RESPONSE_VERSION=v1

# Local provider-neutral subprocess configuration.
# IMAGE_PROVIDER_COMMAND=/absolute/path/to/local-provider-adapter
# IMAGE_PROVIDER_ARGS=[]
# IMAGE_PROVIDER_TIMEOUT_MS=60000
